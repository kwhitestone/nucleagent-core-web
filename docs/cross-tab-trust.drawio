<mxGraphModel adaptiveColors="auto" page="1" pageWidth="1080" pageHeight="840">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="peer" value="另一 tab&#xa;真实 shell store 续期" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="storage" value="原生 storage&#xa;凭据不是主体证明" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="140" height="70" as="geometry"/></mxCell>
    <mxCell id="store" value="接收 shell&#xa;清身份/权限，10秒期限" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="proof" value="服务端 user-info&#xa;绑定 token + version&#xa;再核对当前 storage" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="580" y="40" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="channel" value="原可信 frame 通道&#xa;origin/source/instance&#xa;白名单不扩大" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="pending" value="core 显式待定&#xa;无 token/主体/权限&#xa;旧请求撤销，12秒兜底" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="memory" value="已审计编辑器&#xa;DOM 脱离文档&#xa;草稿仅内存、不可操作" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="220" y="280" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="decision" value="同版本证明&#xa;同主体 + 同有效权限？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="160" height="90" as="geometry"/></mxCell>
    <mxCell id="resume" value="恢复原节点&#xa;草稿、焦点、选区&#xa;不重放写入" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="220" y="520" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="destroy" value="销毁保护内容&#xa;换主体/权限/logout&#xa;401/失败/超时/未知事件" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="legacy" value="兼容旧消费者&#xa;收到空 token 即关闭&#xa;安全保留，草稿不保证" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;fontFamily=Microsoft YaHei,PingFang SC,Noto Sans CJK SC,Arial,sans-serif;" vertex="1" parent="1"><mxGeometry x="760" y="160" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="e1" edge="1" source="peer" target="storage" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
